# 私有数据目录：账本、成交、意向、截图都放这里。必须在仓库之外。
DATA_DIR=/var/lib/honghu

# 委员会口令（至少 16 位）。打开页面时输入一次。
COMMITTEE_TOKEN=

# 战略侧口令（至少 16 位，选填）。用于读取提交内容、交回截图识别结果。不能提交、不能确认。
AGENT_TOKEN=

# 汇总机器人的口令（至少 32 位，选填）。只能读链上数据、占比和净值指数，只能写定时汇总；读不到账本。
# 部署机器人时，把这个值存成它的密钥 HONGHU_AGENT_TOKEN。
BOT_TOKEN=

# 设为 off 时不拉链上数据、不盯线（缺省开启）。
# HONGHU_CHAIN=off

PORT=5000
