{
  "name": "stock-decision-backend",
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "test": "jest",
    "tios:selftest": "tsx src/services/tios/selftest.ts",
    "msr:scan": "tsx src/services/msr/scan.ts",
    "msr:selftest": "tsx src/services/msr/selftest.ts",
    "msr:valuation": "tsx src/services/msr/valuationFetch.ts",
    "cockpit": "tsx src/services/cockpit/run.ts",
    "cockpit:selftest": "tsx src/services/cockpit/selftest.ts",
    "dashboard:selftest": "tsx src/services/cockpit/dashboardSelftest.ts",
    "freeze:check": "tsx src/services/governance/freeze.ts check",
    "freeze:baseline": "tsx src/services/governance/freeze.ts baseline",
    "audit:selftest": "tsx src/services/governance/selftest.ts",
    "profit:fetch": "tsx src/services/research/profitFetch.ts",
    "profit:map": "tsx src/services/research/profitMapRun.ts",
    "research:selftest": "tsx src/services/research/selftest.ts",
    "daily": "npm run freeze:check && HTML=1 OBSIDIAN=1 npm run cockpit && tsx src/services/governance/reviewRun.ts",
    "daily:pre": "SESSION=pre HTML=1 OBSIDIAN=1 npm run cockpit",
    "obsidian": "tsx src/services/cockpit/obsidianExport.ts",
    "obsidian:refresh": "ARCHIVE=0 WEB=1 OBSIDIAN=1 npm run cockpit",
    "obsidian:pre": "SESSION=pre ARCHIVE=0 WEB=1 OBSIDIAN=1 npm run cockpit",
    "obsidian:pull": "tsx src/services/cockpit/obsidianPull.ts",
    "review": "tsx src/services/governance/reviewRun.ts",
    "segments:fetch": "tsx segmentsFetch.ts",
    "decision:selftest": "tsx src/services/decision/selftest.ts",
    "decision:v2": "tsx src/services/decision/v2Selftest.ts",
    "decision:v3": "tsx src/services/decision/v3Selftest.ts",
    "decision:v4": "tsx src/services/decision/v4Selftest.ts",
    "decision:v4x": "tsx src/services/decision/v4xSelftest.ts",
    "money:selftest": "tsx src/services/moneyRadar/selftest.ts",
    "money:demo": "tsx src/services/moneyRadar/demo.ts",
    "money": "tsx src/services/moneyRadar/run.ts",
    "money:calibrate": "tsx src/services/moneyRadar/calibrate.ts",
    "money:share": "tsx src/services/moneyRadar/share.ts",
    "money:publish": "tsx src/services/moneyRadar/publish.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.6.5",
    "node-cron": "^3.0.3",
    "uuid": "^9.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.5",
    "@types/node-cron": "^3.0.11",
    "@types/uuid": "^9.0.7",
    "jest": "^29.7.0",
    "tsx": "^4.6.2",
    "typescript": "^5.3.3"
  }
}
